// Entities are built fresh from the World and the label-set registry on every decision,
// so derived attributes (haLocs, carryTypes) always reflect the current world.
entity Agent;
entity Environment;
entity Location {
  highAssurance: Bool,
  environment: Environment,
};
entity LabelSet {
  selfs: Set<Agent>,
  locs: Set<Location>,
  withs: Set<Agent>,
  haLocs: Set<Location>,      // the high-assurance locations among locs (Cedar can't loop over set members)
  carryTypes: Set<String>,    // memory types every location in locs lets out
  srcs: Set<Location>,        // where a personal memory was carried out of (0.7.0)
  sealedSrcs: Set<Location>,  // the srcs whose environment currently lets nothing out (carry_out: [])
};
action read appliesTo {
  principal: Agent,
  resource: LabelSet,
  context: { location: Location },
};
// Storing any memory under a label set, made at `location`.
action write appliesTo {
  principal: Agent,
  resource: LabelSet,
  context: { location: Location },
};
// Carrying a memory formed under `resource` into the principal's personal memory, from `location`.
action writePersonal appliesTo {
  principal: Agent,
  resource: LabelSet,
  context: { memoryType: String, location: Location },
};
